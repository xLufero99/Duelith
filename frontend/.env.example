# ============================================================
# Variables de entorno del frontend (Vite). Copia a .env y
# completa los valores reales. NUNCA pongas claves privadas aqui:
# el frontend solo necesita la PUBLIC KEY de Wompi.
# ============================================================

# URL base de la API del backend (el cliente agrega /api).
VITE_API_URL=https://tu-backend-url

# PUBLIC KEY de Wompi (publica, para Wompi JS). No es secreta.
VITE_WOMPI_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxx

# URL del script de Wompi JS.
VITE_WOMPI_JS_URL=https://cdn.wompi.co/libs/js/v1.js
