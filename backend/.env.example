# ===================== SUPABASE =====================
SUPABASE_URL=tu_url_supabase
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=tu_url_jwks
SUPABASE_DB_PASSWORD=tu_password_db

# ===================== JWT PROPIO (HS256) =====================
JWT_SECRET=clave_secreta_jwt_larga_y_aleatoria

# ===================== WOMPI (Pasarela de pagos) =====================
# Sandbox (desarrollo): https://sandbox.wompi.co/v1
# Produccion:           https://production.wompi.co/v1
WOMPI_API_URL=https://sandbox.wompi.co/v1

# PUBLIC_KEY se puede exponer al frontend (Wompi JS).
WOMPI_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxx
# PRIVADA: SOLO backend, NUNCA exponer al frontend.
WOMPI_PRIVATE_KEY=sk_test_xxxxxxxxxxxxxxxxxx
# Llave de integridad para generar signature:integrity (SIEMPRE backend).
WOMPI_INTEGRITY_KEY=it_test_xxxxxxxxxxxxxxxxxx
# Secreto de eventos para verificar la firma de los webhooks (SIEMPRE backend).
WOMPI_EVENTS_SECRET=ev_test_xxxxxxxxxxxxxxxxxx
# Moneda de las transacciones.
WOMPI_CURRENCY=COP

# URLs a donde regresa el usuario tras pagar en el widget de Wompi.
WOMPI_SUCCESS_URL=https://tu-dominio.com/donaciones/exito
WOMPI_FAILURE_URL=https://tu-dominio.com/donaciones/fallo
WOMPI_PENDING_URL=https://tu-dominio.com/donaciones/pendiente

# ===================== DONACIONES (limites y rate limiting) =====================
MIN_DONATION_AMOUNT=1000
MAX_DONATION_AMOUNT=10000000
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=60

# ===================== CORS (SOLO origenes del frontend, nunca *) =====================
# Separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8443,https://tu-dominio.com
